--- /dev/null
+++ b/src/ui/platform/frame_experiment.rs
@@ -0,0 +1,266 @@
+//! Scratch frame-timing switches for the 2026-11 frame/render session in
+//! PERFORMANCE.md. Not for merging; kept as performance/frame-experiments.patch.
+//!
+//! - `DD_FRAME_TRACE=<path>`: per-frame QPC timestamps and input counts, written
+//!   on exit, plus a frame-number marker drawn in the client's top-left corner
+//!   for `benches/frame_probe` to read off the screen.
+//! - `DD_PRESENT=immediately`: `D2D1_PRESENT_OPTIONS_IMMEDIATELY`.
+//! - `DD_FLIP=1|0|wait|loop|loop0`: a flip-model swap chain instead of the HWND
+//!   target. `0` presents with sync interval 0. `wait` blocks on a
+//!   frame-latency waitable (max latency 1) at the start of each paint;
+//!   `loop` waits on it in the message loop instead and paints only once it
+//!   signals (`loop0`: the same with sync interval 0).
+//! - The `perf` Cargo profile builds into target/perf, beside a running
+//!   target/release exe.
+
+use std::cell::RefCell;
+use std::io::Write;
+use std::mem::ManuallyDrop;
+
+use windows::Win32::Foundation::{HANDLE, HMODULE, HWND};
+use windows::Win32::Graphics::Direct2D::Common::*;
+use windows::Win32::Graphics::Direct2D::*;
+use windows::Win32::Graphics::Direct3D::*;
+use windows::Win32::Graphics::Direct3D11::*;
+use windows::Win32::Graphics::Dxgi::Common::*;
+use windows::Win32::Graphics::Dxgi::*;
+use windows::Win32::System::Performance::QueryPerformanceCounter;
+use windows::Win32::System::Threading::WaitForSingleObjectEx;
+use windows::core::Interface;
+
+pub(crate) fn qpc() -> i64 {
+    let mut value = 0;
+    unsafe {
+        let _ = QueryPerformanceCounter(&mut value);
+    }
+    value
+}
+
+struct Trace {
+    path: String,
+    lines: Vec<String>,
+    frame: u32,
+    inputs: u32,
+}
+
+thread_local! {
+    static TRACE: RefCell<Option<Trace>> = RefCell::new(std::env::var("DD_FRAME_TRACE").ok().map(|path| Trace {
+        path,
+        lines: Vec::with_capacity(100_000),
+        frame: 0,
+        inputs: 0,
+    }));
+}
+
+pub(crate) fn input() {
+    TRACE.with(|t| {
+        if let Some(trace) = t.borrow_mut().as_mut() {
+            trace.inputs += 1;
+            let line = format!("I,{},{}", trace.inputs, qpc());
+            trace.lines.push(line);
+        }
+    });
+}
+
+/// The next frame's number and the inputs dispatched before it.
+pub(crate) fn begin_frame() -> Option<(u32, u32)> {
+    TRACE.with(|t| {
+        t.borrow_mut().as_mut().map(|trace| {
+            trace.frame += 1;
+            (trace.frame, trace.inputs)
+        })
+    })
+}
+
+pub(crate) fn frame(number: u32, inputs: u32, times: [i64; 5]) {
+    TRACE.with(|t| {
+        if let Some(trace) = t.borrow_mut().as_mut() {
+            let [wait, begin, painted, ended, presented] = times;
+            trace.lines.push(format!("F,{number},{inputs},{wait},{begin},{painted},{ended},{presented}"));
+        }
+    });
+}
+
+pub(crate) fn flush() {
+    TRACE.with(|t| {
+        if let Some(trace) = t.borrow_mut().as_mut()
+            && let Ok(mut file) = std::fs::File::create(&trace.path)
+        {
+            let _ = writeln!(file, "{}", trace.lines.join("\n"));
+            trace.lines.clear();
+        }
+    });
+}
+
+const CELL: f32 = 6.0;
+
+/// 18 cells, `CELL` physical pixels square: a white guard, 16 bits of the
+/// frame number (most significant first), a black guard.
+pub(crate) fn draw_marker(target: &ID2D1RenderTarget, number: u32, scale: f32) {
+    let color = |v: f32| D2D1_COLOR_F { r: v, g: v, b: v, a: 1.0 };
+    unsafe {
+        let (Ok(white), Ok(black)) = (target.CreateSolidColorBrush(&color(1.0), None), target.CreateSolidColorBrush(&color(0.0), None)) else {
+            return;
+        };
+        target.SetAntialiasMode(D2D1_ANTIALIAS_MODE_ALIASED);
+        let size = CELL / scale;
+        for i in 0..18u32 {
+            let on = match i {
+                0 => true,
+                17 => false,
+                _ => (number >> (16 - i)) & 1 == 1,
+            };
+            let x = i as f32 * size;
+            let r = D2D_RECT_F { left: x, top: 0.0, right: x + size, bottom: size };
+            target.FillRectangle(&r, if on { &white } else { &black });
+        }
+        target.SetAntialiasMode(D2D1_ANTIALIAS_MODE_PER_PRIMITIVE);
+    }
+}
+
+pub(crate) fn present_options() -> D2D1_PRESENT_OPTIONS {
+    match std::env::var("DD_PRESENT").as_deref() {
+        Ok("immediately") => D2D1_PRESENT_OPTIONS_IMMEDIATELY,
+        _ => D2D1_PRESENT_OPTIONS_NONE,
+    }
+}
+
+pub(crate) fn flip_mode() -> Option<String> {
+    std::env::var("DD_FLIP").ok()
+}
+
+thread_local! {
+    // DD_FLIP=loop: the frame-latency waitable, waited on in the message loop.
+    static LOOP_WAIT: std::cell::Cell<Option<HANDLE>> = const { std::cell::Cell::new(None) };
+    static READY: std::cell::Cell<bool> = const { std::cell::Cell::new(true) };
+}
+
+/// The handle the message loop should also wait on, if a frame is waiting
+/// for the swap chain.
+pub(crate) fn loop_handle() -> Option<HANDLE> {
+    if READY.get() { None } else { LOOP_WAIT.get() }
+}
+
+pub(crate) fn set_ready() {
+    READY.set(true);
+}
+
+pub(crate) fn looping() -> bool {
+    LOOP_WAIT.get().is_some()
+}
+
+/// Whether painting must wait for the swap chain.
+pub(crate) fn blocked() -> bool {
+    looping() && !READY.get()
+}
+
+pub(crate) fn take_ready() -> bool {
+    READY.replace(false)
+}
+
+pub(crate) struct Flip {
+    pub context: ID2D1DeviceContext,
+    swap: IDXGISwapChain1,
+    blocking: bool,
+    waitable: Option<HANDLE>,
+    bitmap: Option<ID2D1Bitmap1>,
+    interval: u32,
+    flags: u32,
+}
+
+impl Flip {
+    pub(crate) fn new(hwnd: HWND, factory: &ID2D1Factory, mode: &str) -> windows::core::Result<Self> {
+        let blocking = mode == "wait";
+        let waitable = blocking || mode.starts_with("loop");
+        let interval = if mode.ends_with('0') { 0 } else { 1 };
+        unsafe {
+            let mut device = None;
+            D3D11CreateDevice(
+                None,
+                D3D_DRIVER_TYPE_HARDWARE,
+                HMODULE::default(),
+                D3D11_CREATE_DEVICE_BGRA_SUPPORT,
+                Some(&[D3D_FEATURE_LEVEL_11_0]),
+                D3D11_SDK_VERSION,
+                Some(&mut device),
+                None,
+                None,
+            )?;
+            let device = device.unwrap();
+            let dxgi_device: IDXGIDevice = device.cast()?;
+            let factory1: ID2D1Factory1 = factory.cast()?;
+            let d2d_device = factory1.CreateDevice(&dxgi_device)?;
+            let context = d2d_device.CreateDeviceContext(D2D1_DEVICE_CONTEXT_OPTIONS_NONE)?;
+            let adapter = dxgi_device.GetAdapter()?;
+            let dxgi_factory: IDXGIFactory2 = adapter.GetParent()?;
+            let flags = if waitable { DXGI_SWAP_CHAIN_FLAG_FRAME_LATENCY_WAITABLE_OBJECT.0 as u32 } else { 0 };
+            let desc = DXGI_SWAP_CHAIN_DESC1 {
+                Width: 0,
+                Height: 0,
+                Format: DXGI_FORMAT_B8G8R8A8_UNORM,
+                Stereo: false.into(),
+                SampleDesc: DXGI_SAMPLE_DESC { Count: 1, Quality: 0 },
+                BufferUsage: DXGI_USAGE_RENDER_TARGET_OUTPUT,
+                BufferCount: 2,
+                Scaling: DXGI_SCALING_NONE,
+                SwapEffect: DXGI_SWAP_EFFECT_FLIP_DISCARD,
+                AlphaMode: DXGI_ALPHA_MODE_IGNORE,
+                Flags: flags,
+            };
+            let swap = dxgi_factory.CreateSwapChainForHwnd(&device, hwnd, &desc, None, None)?;
+            let waitable = if waitable {
+                let swap2: IDXGISwapChain2 = swap.cast()?;
+                swap2.SetMaximumFrameLatency(1)?;
+                let handle = swap2.GetFrameLatencyWaitableObject();
+                if !blocking {
+                    // The object starts signaled; the first frame waits too.
+                    WaitForSingleObjectEx(handle, 1000, true);
+                    LOOP_WAIT.set(Some(handle));
+                }
+                Some(handle)
+            } else {
+                None
+            };
+            Ok(Self { context, swap, blocking, waitable, bitmap: None, interval, flags })
+        }
+    }
+
+    pub(crate) fn wait(&self) {
+        if let Some(handle) = self.waitable.filter(|_| self.blocking) {
+            unsafe {
+                WaitForSingleObjectEx(handle, 1000, true);
+            }
+        }
+    }
+
+    pub(crate) fn prepare(&mut self, dpi: f32) -> windows::core::Result<()> {
+        unsafe {
+            if self.bitmap.is_none() {
+                let surface: IDXGISurface = self.swap.GetBuffer(0)?;
+                let props = D2D1_BITMAP_PROPERTIES1 {
+                    pixelFormat: D2D1_PIXEL_FORMAT { format: DXGI_FORMAT_B8G8R8A8_UNORM, alphaMode: D2D1_ALPHA_MODE_IGNORE },
+                    dpiX: dpi,
+                    dpiY: dpi,
+                    bitmapOptions: D2D1_BITMAP_OPTIONS_TARGET | D2D1_BITMAP_OPTIONS_CANNOT_DRAW,
+                    colorContext: ManuallyDrop::new(None),
+                };
+                let bitmap = self.context.CreateBitmapFromDxgiSurface(&surface, Some(&props))?;
+                self.context.SetTarget(&bitmap);
+                self.bitmap = Some(bitmap);
+            }
+        }
+        Ok(())
+    }
+
+    pub(crate) fn present(&self) -> windows::core::Result<()> {
+        unsafe { self.swap.Present(self.interval, DXGI_PRESENT(0)).ok() }
+    }
+
+    pub(crate) fn resize(&mut self, width: u32, height: u32) {
+        unsafe {
+            self.context.SetTarget(None);
+            self.bitmap = None;
+            let _ = self.swap.ResizeBuffers(0, width.max(1), height.max(1), DXGI_FORMAT_UNKNOWN, DXGI_SWAP_CHAIN_FLAG(self.flags as i32));
+        }
+    }
+}
