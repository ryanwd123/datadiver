+fn render_flip<V: View>(runtime: &Runtime<V>, slot: &WindowSlot<V>, hwnd: HWND, mode: &str) {
+    use super::frame_experiment as fx;
+    let (mut flip, mut brushes, scale) = {
+        let mut state = slot.state.borrow_mut();
+        if state.flip.is_none() {
+            match fx::Flip::new(hwnd, &d2d_factory(), mode) {
+                Ok(flip) => state.flip = Some(flip),
+                Err(error) => {
+                    eprintln!("flip swap chain: {error}");
+                    return;
+                }
+            }
+            state.brushes.clear();
+        }
+        if fx::looping() && !fx::take_ready() {
+            // The swap chain still holds a frame; the message loop paints
+            // once its waitable signals.
+            slot.dirty.set(true);
+            unsafe {
+                let _ = ValidateRect(Some(hwnd), None);
+            }
+            return;
+        }
+        (state.flip.take().unwrap(), std::mem::take(&mut state.brushes), state.scale)
+    };
+    let dpi = scale * 96.0;
+    let wait = fx::qpc();
+    flip.wait();
+    let frame = fx::begin_frame();
+    let begin = fx::qpc();
+    let ok = flip.prepare(dpi).is_ok();
+    let target: &ID2D1RenderTarget = &flip.context;
+    let mut painted = false;
+    let (mut drawn, mut ended) = (begin, begin);
+    let mut result = Ok(());
+    if ok {
+        unsafe {
+            target.SetDpi(dpi, dpi);
+            target.BeginDraw();
+        }
+        painted = paint_into(runtime, slot, target, &mut brushes);
+        if let Some((number, _)) = frame {
+            fx::draw_marker(target, number, scale);
+        }
+        drawn = fx::qpc();
+        result = unsafe { target.EndDraw(None, None) };
+        ended = fx::qpc();
+        if result.is_ok() {
+            result = flip.present();
+        }
+    }
+    let presented = fx::qpc();
+    if let Some((number, inputs)) = frame {
+        fx::frame(number, inputs, [wait, begin, drawn, ended, presented]);
+    }
+    let mut state = slot.state.borrow_mut();
+    state.brushes = brushes;
+    state.flip = Some(flip);
+    if let Err(error) = result {
+        eprintln!("flip present: {error}");
+    }
+    if painted && !slot.dirty.get() {
+        unsafe {
+            let _ = ValidateRect(Some(hwnd), None);
+        }
+    }
+}
